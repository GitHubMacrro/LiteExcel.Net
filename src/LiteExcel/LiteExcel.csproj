<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LiteExcel</AssemblyName>
    <RootNamespace>LiteExcel</RootNamespace>
    <PackageId>LiteExcel</PackageId>
    <Version>2.4.6</Version>
    <Authors>JackZ</Authors>	  
    <Description>轻量级 xlsx/xlsm/xlsb/xls/csv 读写库：文件级密码（打开/修改）、超链接、冻结窗格、图片（浮动/单元格内嵌/锚点/AltText），零第三方依赖，AOT 友好，支持 net48 和 net8.0。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>xlsx;xlsm;csv;excel;spreadsheet;aot;net48;net8;streaming;hyperlink;freeze;image;password</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	  <RepositoryUrl>https://github.com/GitHubMacrro/LiteExcel.Net.git</RepositoryUrl>
	  <PackageProjectUrl>https://github.com/GitHubMacrro/LiteExcel.Net</PackageProjectUrl>
	  <Copyright>Copyright (c) $([System.DateTime]::Now.Year) GitHubMacrro</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <Nullable>disable</Nullable>
    <NoWarn>CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
    <None Include="..\..\README.zh-CN.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.zh-CN.md')" />
    <None Include="..\..\README.en.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.en.md')" />
    <None Include="..\..\docs\USAGE.zh-CN.md" Pack="true" PackagePath="docs\" Condition="Exists('..\..\docs\USAGE.zh-CN.md')" />
    <None Include="..\..\docs\USAGE.en.md" Pack="true" PackagePath="docs\" Condition="Exists('..\..\docs\USAGE.en.md')" />
    <None Include="..\..\docs\CHANGELOG.md" Pack="true" PackagePath="docs\" Condition="Exists('..\..\docs\CHANGELOG.md')" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LiteExcel.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
